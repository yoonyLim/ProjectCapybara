            "m_Id": "0c5285ec94aa488f90f767a16645c25a"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GetMainLightShadow_float",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "ShadowAttenuation = 1.0;\n    \n    #ifndef SHADERGRAPH_PREVIEW\n        #if defined(_MAIN_LIGHT_SHADOWS) || defined(_MAIN_LIGHT_SHADOWS_CASCADE)\n            float4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\n            \n            Light mainLight = GetMainLight();\n            ShadowAttenuation = mainLight.shadowAttenuation;\n            \n            // ShadowAttenuation = MainLightRealtimeShadow(shadowCoord);\n        #endif\n    #endif"
}

